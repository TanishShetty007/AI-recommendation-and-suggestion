# ShopSmart AI - Environment Variables Template
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# Flask & JWT Secrets
SECRET_KEY=shopsmart-secret-dev-key
JWT_SECRET_KEY=shopsmart-jwt-secret-key

# Google Gemini AI API Key (Required for AI recommendations, semantic search, and comparisons)
# Get a key for free from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Optional - Defaults to SQLite if omitted)
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DB=shopsmart_db
# MYSQL_PORT=3306
