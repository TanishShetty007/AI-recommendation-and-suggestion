# ShopSmart AI - Environment Variables Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# On AWS Elastic Beanstalk, set these via:
#   EB Console → Configuration → Software → Environment Properties

# ── Flask Security ─────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-here
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# ── Google Gemini AI ───────────────────────────────────
# Required for AI recommendations, semantic search, and comparisons.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ───────────────────────────────────────────
# Defaults to SQLite (instance/shopsmart.db) if MySQL vars are not set.
# For AWS RDS MySQL, uncomment and fill in the values below:
# MYSQL_HOST=your-rds-endpoint.rds.amazonaws.com
# MYSQL_USER=shopsmart_user
# MYSQL_PASSWORD=your_db_password
# MYSQL_DB=shopsmart_db
# MYSQL_PORT=3306

# ── Production Settings ────────────────────────────────
# Uncomment these when deploying to AWS:
# FLASK_ENV=production
# FLASK_DEBUG=0
# LOG_LEVEL=info
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# PORT=5000
