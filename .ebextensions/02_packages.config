packages:
  yum:
    # Required for PyMySQL / cryptography builds on Amazon Linux 2
    gcc: []
    python3-devel: []
    openssl-devel: []

container_commands:
  01_upgrade_pip:
    command: "pip install --upgrade pip"
  02_install_requirements:
    command: "pip install -r requirements.txt"
  03_db_upgrade:
    # Run Flask-Migrate upgrade on each deploy to keep DB schema in sync
    command: "flask db upgrade"
    env:
      FLASK_APP: "wsgi:application"
    leader_only: true   # Only run on the primary instance during rolling deploys
